# Copy to .env and fill in. NEVER commit .env — it holds secrets.

# --- Django ---
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database ---
# Leave empty to use the local SQLite fallback (dev/tests).
# For Docker Compose Postgres, use:
# DATABASE_URL=postgres://fantasy:fantasy@db:5432/fantasy
DATABASE_URL=

# --- ESPN Fantasy (your OWN league credentials; read-only, sync-time only) ---
# Obtain ESPN_S2 and SWID from your browser cookies while logged in to
# fantasy.espn.com — see docs/DATA_SOURCES.md#authentication-cookies.
# These authenticate AS YOU. Keep them secret; never share or commit.
ESPN_LEAGUE_ID=
ESPN_S2=
ESPN_SWID=
ESPN_START_YEAR=
